# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=stats19
POSTGRES_USER=stats19
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# 127.0.0.1 = this host only; 0.0.0.0 = reachable from the LAN (e.g. Mac -> BOSGAME)
POSTGRES_BIND=127.0.0.1

# Postgres memory (tune to the host). Shared buffers: about a third of the memory left free
# by other apps; 1GB is cautious, and the BOSGAME (~9 GB available) runs 3GB (FU-052).
PG_SHARED_BUFFERS=1GB
PG_MAINTENANCE_WORK_MEM=1GB

# Pipeline
STATS19_CHECK_INTERVAL_HOURS=24
STATS19_KEEP_RELEASES=2

# API (Caddy fronts it at WEB_PORT/api; bind it to the LAN only for direct access)
API_BIND=127.0.0.1
API_PORT=8000

# Web front end (Caddy). WEB_BIND=0.0.0.0 to open it to the LAN.
WEB_BIND=127.0.0.1
WEB_PORT=8080
BASEMAP_DIR=./data/basemap

# Backups (pg_dump of core, mart, geo, etl, app). Point BACKUP_DIR at a NAS mount in production.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=168
BACKUP_KEEP=4
# Saved schemes (schema app) daily into BACKUP_DIR/app: the only data that can't be rebuilt
APP_BACKUP_INTERVAL_HOURS=24
APP_BACKUP_KEEP=30

# For running the CLI on the host against the compose database:
STATS19_DATABASE_URL=postgresql://stats19:change-me@localhost:5432/stats19
STATS19_DATA_DIR=data
# Where the API's headless Chromium loads print pages for PDFs (compose sets http://web).
# Host development: the Vite dev server.
# STATS19_REPORT_BASE_URL=http://localhost:5173

# --- Remote access (PLAN-006; on the BOSGAME only) -----------------------------------
# Start the Cloudflare tunnel with the rest of the stack.
# COMPOSE_PROFILES=remote
# The tunnel token from Zero Trust → Networks → Connectors → stats19-e2. Secret: never commit.
# CLOUDFLARE_TUNNEL_TOKEN=
# The Access application the API checks remote requests against (not secret).
# STATS19_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# STATS19_ACCESS_AUD=<access-application-aud-tag>
# The API connects as a read-only role (PLAN-006 C4). Pick a long random password
# (openssl rand -hex 24); `docker compose run --rm pipeline migrate` applies it.
# STATS19_API_DB_USER=stats19_api
# STATS19_API_DB_PASSWORD=
